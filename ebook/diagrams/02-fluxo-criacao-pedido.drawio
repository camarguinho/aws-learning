<mxfile host="app.diagrams.net">
  <diagram name="Fluxo de Criacao de Pedido" id="order-flow">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s1" value="1. Cliente chama POST /api/v1/orders no order-service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="440" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="2. order-service chama GET /products/{id} no catalog-service&#10;(Resilience4j: Retry + CircuitBreaker + Bulkhead)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="130" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="3. catalog-service lê do Redis (cache-aside);&#10;em caso de miss, consulta o DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="200" y="230" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="4. Estoque insuficiente? &#10;Sim -&gt; HTTP 422 (BusinessException) e fim do fluxo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="200" y="330" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="5. order-service grava o pedido (transação ACID)&#10;na tabela orders/order_items do Amazon RDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="200" y="430" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="6. order-service publica OrderCreatedEvent&#10;no tópico Amazon SNS order-notifications-topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="530" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="7. order-service responde HTTP 201 ao cliente&#10;(não espera a notificação — desacoplamento assíncrono)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="630" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="8. SNS entrega (fan-out) a mensagem na fila&#10;Amazon SQS order-events-queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="730" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="9. notification-service consome via @SqsListener&#10;e envia e-mail de confirmação via Amazon SES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="830" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s10" value="10. Falha no envio? A mensagem volta à fila;&#10;após N tentativas, cai automaticamente na DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="200" y="930" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="não" style="html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="html=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="html=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="html=1;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="html=1;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
