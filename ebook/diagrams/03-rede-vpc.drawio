<mxfile host="app.diagrams.net">
  <diagram name="Rede VPC" id="vpc-network">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="internet" value="Internet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="540" y="20" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="igw" value="Internet Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="540" y="110" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="vpc" value="VPC 10.0.0.0/16 (us-east-1)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#232F3E;dashed=1;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="1080" height="560" as="geometry" />
        </mxCell>

        <mxCell id="alb" value="Application Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="200" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="azA" value="Availability Zone A" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="280" width="480" height="440" as="geometry" />
        </mxCell>

        <mxCell id="azB" value="Availability Zone B" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="280" width="480" height="440" as="geometry" />
        </mxCell>

        <mxCell id="pubA" value="Subnet pública 10.0.0.0/24&#10;NAT Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="140" y="320" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="privAppA" value="Subnet privada (app) 10.0.10.0/24&#10;catalog-service / order-service / notification-service&#10;(ECS Fargate ou EC2 em Auto Scaling Group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="140" y="420" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="privDataA" value="Subnet privada (dados) 10.0.20.0/24&#10;Amazon RDS (primary) + ElastiCache (nó primário)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="140" y="540" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pubB" value="Subnet pública 10.0.1.0/24&#10;NAT Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="privAppB" value="Subnet privada (app) 10.0.11.0/24&#10;réplicas dos microsserviços" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="640" y="420" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="privDataB" value="Subnet privada (dados) 10.0.21.0/24&#10;Amazon RDS (standby Multi-AZ) + ElastiCache (réplica)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="540" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="endpoints" value="VPC Endpoints (Gateway/Interface)&#10;S3 · DynamoDB · SQS · SNS · Secrets Manager · SSM&#10;(tráfego para os serviços AWS sem sair pela Internet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="290" y="660" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="html=1;" edge="1" parent="1" source="internet" target="igw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="html=1;" edge="1" parent="1" source="igw" target="alb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="html=1;" edge="1" parent="1" source="alb" target="privAppA"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="html=1;" edge="1" parent="1" source="alb" target="privAppB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="html=1;" edge="1" parent="1" source="privAppA" target="privDataA"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="html=1;" edge="1" parent="1" source="privAppB" target="privDataB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="replicação síncrona" style="html=1;dashed=1;" edge="1" parent="1" source="privDataA" target="privDataB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="html=1;" edge="1" parent="1" source="privAppA" target="endpoints"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="html=1;" edge="1" parent="1" source="privAppB" target="endpoints"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
