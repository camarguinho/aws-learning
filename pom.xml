<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Herdar do spring-boot-starter-parent (em vez de só importar o BOM
        spring-boot-dependencies) traz de graça o pluginManagement do
        spring-boot-maven-plugin já com o goal "repackage" vinculado à fase
        "package". Sem isso, `mvn package` gera o jar "plain" (sem
        Main-Class, sem dependências embutidas) e o container falha com
        "no main manifest attribute, in app.jar" — foi exatamente o bug do
        piloto MiniStack antes deste ajuste.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>br.com.camarguinho.awslearning</groupId>
    <artifactId>ecommerce-aws-spring-cloud</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ecommerce-aws-spring-cloud</name>
    <description>
        Case de e-commerce cloud native usado como projeto de estudo para a certificacao
        AWS Certified Solutions Architect - Associate (SAA-C03), integrado via Spring Cloud AWS.
    </description>

    <modules>
        <module>services/common</module>
        <module>services/catalog-service</module>
        <module>services/order-service</module>
        <module>services/notification-service</module>
    </modules>

    <properties>
        <!-- spring-boot-starter-parent usa este java.version para computar
             maven.compiler.release automaticamente. -->
        <java.version>21</java.version>

        <spring-cloud-aws.version>3.2.1</spring-cloud-aws.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <!-- spring-boot-dependencies (BOM) já vem herdado do
         spring-boot-starter-parent — só precisamos importar os BOMs que
         não fazem parte do ecossistema oficial do Spring Boot. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>${spring-cloud-aws.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-reactor</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.camarguinho.awslearning</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
